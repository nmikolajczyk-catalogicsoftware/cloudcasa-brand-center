{
  "name": "brand-center-tooling",
  "private": true,
  "description": "Lint and test tooling. Not part of the deployed site (tools/ is excluded by .vercelignore).",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run format:check",
    "lint:js": "cd .. && eslint -c tools/eslint.config.mjs assets/js tests tools --no-warn-ignored",
    "lint:css": "cd .. && stylelint --config tools/.stylelintrc.json \"assets/css/*.css\"",
    "lint:html": "cd .. && html-validate -c tools/.htmlvalidate.json index.html",
    "format": "cd .. && prettier --config tools/.prettierrc.json --write \"assets/css/*.css\" \"assets/js/*.js\" \"tests/**/*.{js,mjs}\" \"tools/*.{mjs,json}\" variants.json vercel.json",
    "format:check": "cd .. && prettier --config tools/.prettierrc.json --check \"assets/css/*.css\" \"assets/js/*.js\" \"tests/**/*.{js,mjs}\" \"tools/*.{mjs,json}\" variants.json vercel.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
